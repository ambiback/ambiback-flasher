# Copy this file to .env next to the application. .env is ignored by Git.
# Authentication uses your local OpenSSH setup. Passwords are not stored here.

# Required: server name, IP address or alias from ~/.ssh/config
AMBIBACK_UPLOAD_HOST=firmware.example.com

# Optional: SSH user, otherwise your OpenSSH default is used
#AMBIBACK_UPLOAD_USER=deploy

# Optional: SSH port
#AMBIBACK_UPLOAD_PORT=22

# Optional: remote base folder. Images go to <path>/<device>/<version>/update.bin
#AMBIBACK_UPLOAD_PATH=firmware/esp32

# Optional: private key file, otherwise ssh-agent and your default keys are used
#AMBIBACK_UPLOAD_KEY=~/.ssh/ambiback_upload
